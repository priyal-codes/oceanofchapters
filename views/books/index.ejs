<% layout("/layouts/boilerplate") -%>

<div class="container my-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="font-serif display-6 mb-1">Explore <em>All Books</em></h1>
            <p class="text-muted mb-0">Browse our complete collection of stories and novels</p>
        </div>

        <% if ((typeof search !== 'undefined' && search) || (typeof genre !== 'undefined' && genre)) { %>
            <div class="mt-3 mt-md-0">
                <span class="badge bg-primary-subtle text-primary border me-2 py-2 px-3 rounded-pill">
                    Filter: <strong><%= search || genre %></strong>
                </span>
                <a href="/books" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                    <i class="fa-solid fa-xmark me-1"></i> Clear
                </a>
            </div>
        <% } %>
    </div>

    <% if (allBooks && allBooks.length > 0) { %>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-4">
            <% for(let book of allBooks) { %>
                <div class="col">
                    <div class="card h-100 book-home-card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="position-relative overflow-hidden book-img-container">
                            <img src="<%= book.image %>" class="card-img-top book-card-img" alt="<%= book.title %>">
                            <% if (book.genre && book.genre.length > 0) { %>
                                <span class="badge bg-dark bg-opacity-75 backdrop-blur position-absolute top-0 end-0 m-3 px-2 py-1 rounded-pill small">
                                    <%= Array.isArray(book.genre) ? book.genre[0] : book.genre %>
                                </span>
                            <% } %>
                            <div class="book-card-hover-actions position-absolute top-0 start-0 w-100 h-100 bg-dark bg-opacity-40 backdrop-blur d-flex align-items-center justify-content-center gap-2 opacity-0">
                                <a href="/books/<%= book._id %>" class="btn btn-light rounded-pill px-3 py-2 shadow fw-semibold small">
                                    <i class="fa-solid fa-eye me-1"></i> View
                                </a>
                                <form action="/cart/add/<%= book._id %>" method="POST" class="d-inline">
                                    <button type="submit" class="btn btn-ocean-primary rounded-pill px-3 py-2 shadow fw-semibold small">
                                        <i class="fa-solid fa-cart-plus me-1"></i> Add
                                    </button>
                                </form>
                            </div>
                        </div>
                        <div class="card-body p-3 d-flex flex-column">
                            <small class="text-muted mb-1"><i class="fa-solid fa-user-pen me-1"></i> <%= book.author %></small>
                            <h5 class="card-title fw-bold text-dark text-truncate mb-2" title="<%= book.title %>">
                                <a href="/books/<%= book._id %>" class="text-decoration-none text-dark hover-primary">
                                    <%= book.title %>
                                </a>
                            </h5>
                            <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="fs-5 fw-bold text-success">
                                    &#8377;<%= book.price ? book.price.toLocaleString("en-IN") : '299' %>
                                </span>
                                <a href="/books/<%= book._id %>" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                                    Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    <% } else { %>
        <div class="text-center py-5 my-4 bg-white rounded-4 border shadow-sm">
            <i class="fa-solid fa-magnifying-glass fs-1 text-muted mb-3 d-block"></i>
            <h3>No books found matching your search</h3>
            <p class="text-muted">Try searching with a different keyword or browse all titles.</p>
            <a href="/books" class="btn btn-primary rounded-pill px-4 py-2 mt-2">View All Books</a>
        </div>
    <% } %>
</div>
