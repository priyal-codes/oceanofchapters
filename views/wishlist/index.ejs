<% layout("/layouts/boilerplate") -%>

<div class="container my-5">
    <!-- Wishlist Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="font-serif display-6 mb-1">My <em>Wishlist</em> ❤️</h1>
            <p class="text-muted mb-0">Your saved books and personal reading list</p>
        </div>

        <div class="mt-3 mt-md-0">
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill font-monospace">
                <i class="fa-solid fa-heart me-1"></i> <%= books ? books.length : 0 %> Saved Books
            </span>
        </div>
    </div>

    <% if (books && books.length > 0) { %>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-4">
            <% for(let book of books) { %>
                <div class="col">
                    <div class="card h-100 book-home-card border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                        <!-- Toggle Wishlist Icon Button -->
                        <form action="/wishlist/toggle/<%= book._id %>" method="POST" class="position-absolute top-0 start-0 m-3 z-3">
                            <button type="submit" class="btn btn-light rounded-circle shadow-sm p-2 d-flex align-items-center justify-content-center border" style="width: 36px; height: 36px;" title="Remove from Wishlist">
                                <i class="fa-solid fa-heart text-danger fs-6"></i>
                            </button>
                        </form>

                        <a href="/books/<%= book._id %>" class="text-decoration-none">
                            <div class="position-relative overflow-hidden book-img-container">
                                <img src="<%= book.image %>" class="card-img-top book-card-img" alt="<%= book.title %>">
                                <% if (book.genre && book.genre.length > 0) { %>
                                    <span class="badge bg-dark bg-opacity-75 backdrop-blur position-absolute top-0 end-0 m-3 px-2 py-1 rounded-pill small text-white">
                                        <%= Array.isArray(book.genre) ? book.genre[0] : book.genre %>
                                    </span>
                                <% } %>
                            </div>
                        </a>

                        <div class="card-body p-3 d-flex flex-column">
                            <small class="text-muted mb-1 text-truncate"><i class="fa-solid fa-user-pen me-1"></i> <%= book.author %></small>
                            <h5 class="card-title fw-bold text-dark text-truncate mb-2" title="<%= book.title %>">
                                <a href="/books/<%= book._id %>" class="text-decoration-none text-dark hover-primary">
                                    <%= book.title %>
                                </a>
                            </h5>

                            <div class="mt-auto pt-2 border-top">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fs-5 fw-bold text-success">
                                        &#8377;<%= book.price ? book.price.toLocaleString("en-IN") : '299' %>
                                    </span>
                                    <a href="/books/<%= book._id %>" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                                        Details
                                    </a>
                                </div>
                                <form action="/cart/add/<%= book._id %>" method="POST" class="w-100">
                                    <button type="submit" class="btn btn-sm btn-ocean-primary rounded-pill w-100 py-2 shadow-sm fw-bold">
                                        <i class="fa-solid fa-cart-plus me-1"></i> Move to Cart
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    <% } else { %>
        <!-- Empty Wishlist State -->
        <div class="text-center py-5 my-4 bg-white rounded-4 border shadow-sm max-w-xl mx-auto p-5">
            <div class="bg-danger bg-opacity-10 text-danger rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                <i class="fa-solid fa-heart-crack display-4"></i>
            </div>
            <h3 class="font-serif fw-bold">Your Wishlist is Empty</h3>
            <p class="text-muted mb-4">You haven't saved any books to your wishlist yet. Explore our catalog and click the heart icon on any book you love!</p>
            <a href="/books" class="btn btn-ocean-primary rounded-pill px-5 py-3 shadow fw-bold">
                <i class="fa-solid fa-book-open me-2"></i> Explore Book Catalog
            </a>
        </div>
    <% } %>
</div>
