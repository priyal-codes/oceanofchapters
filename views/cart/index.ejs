<% layout("/layouts/boilerplate") -%>

<div class="container my-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="font-serif display-6 mb-1">Your Shopping <em>Cart</em> 🛒</h1>
            <p class="text-muted mb-0">
                <% if (cart && cart.items && cart.items.length > 0) { %>
                    You have <strong><%= cart.items.length %></strong> title(s) in your cart
                <% } else { %>
                    Your cart is currently empty
                <% } %>
            </p>
        </div>
        <a href="/books" class="btn btn-outline-primary rounded-pill px-4 mt-3 mt-md-0 fw-semibold">
            <i class="fa-solid fa-plus me-1"></i> Add More Books
        </a>
    </div>

    <% if (!cart || !cart.items || cart.items.length === 0) { %>
        <!-- Empty Cart State -->
        <div class="text-center py-5 my-4 bg-white rounded-4 border shadow-sm max-w-2xl mx-auto p-5">
            <div class="bg-primary bg-opacity-10 text-primary rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 90px; height: 90px;">
                <i class="fa-solid fa-bag-shopping display-5"></i>
            </div>
            <h3 class="font-serif fw-bold mb-2">Your Reading Bag is Empty</h3>
            <p class="text-muted mb-4 max-w-md mx-auto">Explore our collection of bestselling romance, gripping thrillers, and timeless classics to fill your shelf.</p>
            <a href="/books" class="btn btn-ocean-primary btn-lg rounded-pill px-5 shadow fw-semibold">
                <i class="fa-solid fa-compass me-2"></i> Explore Books Collection
            </a>
        </div>
    <% } else { %>
        <!-- Cart Items & Order Summary Layout -->
        <div class="row g-4">
            <!-- Left Side: Cart Items List -->
            <div class="col-lg-8">
                <div class="d-flex flex-column gap-3">
                    <% 
                    let total = 0;
                    cart.items.forEach(item => { 
                        if (item.book) {
                            total += item.book.price * item.quantity;
                    %>
                        <div class="card border rounded-4 p-3 shadow-sm bg-white hover-shadow transition-all">
                            <div class="row align-items-center g-3">
                                <!-- Book Thumbnail -->
                                <div class="col-3 col-sm-2 text-center">
                                    <a href="/books/<%= item.book._id %>">
                                        <img src="<%= item.book.image %>" alt="<%= item.book.title %>" class="img-fluid rounded-2 shadow-sm" style="max-height: 100px; object-fit: contain;">
                                    </a>
                                </div>

                                <!-- Book Info -->
                                <div class="col-9 col-sm-4">
                                    <small class="text-muted d-block text-truncate"><%= item.book.author %></small>
                                    <h6 class="fw-bold mb-1 text-truncate">
                                        <a href="/books/<%= item.book._id %>" class="text-decoration-none text-dark hover-primary">
                                            <%= item.book.title %>
                                        </a>
                                    </h6>
                                    <span class="text-success fw-bold">
                                        &#8377;<%= item.book.price ? item.book.price.toLocaleString("en-IN") : '0' %>
                                    </span>
                                </div>

                                <!-- Quantity Controls -->
                                <div class="col-6 col-sm-3 text-center">
                                    <div class="d-inline-flex align-items-center border rounded-pill p-1 bg-light">
                                        <form action="/cart/decrease/<%= item.book._id %>" method="POST" class="d-inline">
                                            <button class="btn btn-sm btn-white rounded-circle shadow-none px-2 py-0 border-0" <%= item.quantity === 1 ? "disabled" : "" %>>
                                                <i class="fa-solid fa-minus text-secondary small"></i>
                                            </button>
                                        </form>
                                        <span class="px-3 fw-bold small"><%= item.quantity %></span>
                                        <form action="/cart/increase/<%= item.book._id %>" method="POST" class="d-inline">
                                            <button class="btn btn-sm btn-white rounded-circle shadow-none px-2 py-0 border-0">
                                                <i class="fa-solid fa-plus text-secondary small"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>

                                <!-- Subtotal & Actions -->
                                <div class="col-6 col-sm-3 text-end d-flex align-items-center justify-content-end gap-3">
                                    <div class="fw-bold fs-6 text-dark">
                                        &#8377;<%= (item.book.price * item.quantity).toLocaleString("en-IN") %>
                                    </div>
                                    <form action="/cart/remove/<%= item.book._id %>" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle p-2 border-0 bg-danger bg-opacity-10 text-danger" title="Remove book">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% 
                        }
                    }); 
                    %>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <form action="/cart/clear" method="POST">
                        <button type="submit" class="btn btn-outline-danger rounded-pill px-4 btn-sm">
                            <i class="fa-solid fa-trash me-1"></i> Clear Cart
                        </button>
                    </form>
                    <a href="/books" class="text-decoration-none fw-semibold">
                        <i class="fa-solid fa-arrow-left me-1"></i> Continue Shopping
                    </a>
                </div>
            </div>

            <!-- Right Side: Order Summary Sidebar -->
            <div class="col-lg-4">
                <div class="card border rounded-4 p-4 shadow-sm bg-white position-sticky" style="top: 100px;">
                    <h4 class="font-serif fw-bold mb-3 border-bottom pb-2">Order <em>Summary</em></h4>
                    
                    <div class="d-flex justify-content-between mb-2 text-muted">
                        <span>Items Subtotal</span>
                        <span class="fw-semibold text-dark">&#8377;<%= total.toLocaleString("en-IN") %></span>
                    </div>

                    <div class="d-flex justify-content-between mb-2 text-muted">
                        <span>Shipping Fee</span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">FREE</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 text-muted">
                        <span>Estimated Taxes</span>
                        <span class="fw-semibold text-dark">&#8377;0</span>
                    </div>

                    <hr class="my-3">

                    <div class="d-flex justify-content-between mb-4">
                        <span class="fs-5 fw-bold">Total Amount</span>
                        <span class="fs-4 fw-bold text-success">&#8377;<%= total.toLocaleString("en-IN") %></span>
                    </div>

                    <a href="/checkout" class="btn btn-ocean-primary btn-lg rounded-pill w-100 fw-bold shadow py-3 mb-3">
                        Proceed to Checkout <i class="fa-solid fa-arrow-right ms-2"></i>
                    </a>

                    <div class="bg-light rounded-3 p-3 text-center border">
                        <div class="d-flex justify-content-center gap-3 text-muted mb-2 fs-5">
                            <i class="fa-solid fa-shield-halved text-primary" title="256-Bit SSL Encryption"></i>
                            <i class="fa-solid fa-truck-fast text-success" title="Express Delivery"></i>
                            <i class="fa-solid fa-rotate-left text-warning" title="Easy Returns"></i>
                        </div>
                        <small class="text-muted d-block lh-sm">Guaranteed Secure Checkout & Authentic Book Deliveries</small>
                    </div>
                </div>
            </div>
        </div>
    <% } %>
</div>
